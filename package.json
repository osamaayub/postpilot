{
  "name": "postpilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI LinkedIn post writer built with Next.js 16, PostgreSQL, Drizzle and the OpenAI Responses API.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
