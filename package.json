    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.2",
    "jose": "6.2.14",
    "next": "16.4.6",
    "openai": "7.46.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
