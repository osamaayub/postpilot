# Required: at least 32 random characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional: real PostgreSQL. Leave empty to use the built-in in-memory demo database (PGlite).
DATABASE_URL=

# Optional: real AI. Leave empty to use the demo writer (no API calls, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: posts each user can generate per day (default 10).
DAILY_POST_LIMIT=10
